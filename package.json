{
  "name": "drapewright",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wasm": "pnpm wasm:2d && pnpm wasm:3d",
    "wasm:2d": "wasm-pack build crates/wasm-core --target web --out-dir ../../packages/engine/pkg --release && pnpm wasm:opt",
    "wasm:opt": "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue packages/engine/pkg/drapewright_wasm_core_bg.wasm -o packages/engine/pkg/drapewright_wasm_core_bg.wasm",
    "wasm:3d": "wasm-pack build crates/wasm-3d --target web --out-dir ../../packages/engine/pkg-3d --release && pnpm wasm:opt-3d",
    "wasm:opt-3d": "wasm-opt -O3 --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue packages/engine/pkg-3d/drapewright_wasm_3d_bg.wasm -o packages/engine/pkg-3d/drapewright_wasm_3d_bg.wasm",
    "wasm:dev": "wasm-pack build crates/wasm-core --target web --out-dir ../../packages/engine/pkg --dev && wasm-pack build crates/wasm-3d --target web --out-dir ../../packages/engine/pkg-3d --dev",
    "dev": "pnpm --filter @drapewright/web dev",
    "build": "pnpm wasm && pnpm --filter @drapewright/web build",
    "preview": "pnpm --filter @drapewright/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "pnpm --filter @drapewright/web e2e",
    "licences": "node scripts/check-licences.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "binaryen": "132.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "packageExtensions": {
      "@freesewing/bella@4.10.2": {
        "dependencies": {
          "@freesewing/library": "4.10.2"
        }
      },
      "@freesewing/core-plugins@4.10.2": {
        "dependencies": {
          "@freesewing/plugin-transform": "4.10.2"
        }
      },
      "@freesewing/diana@4.10.2": {
        "dependencies": {
          "@freesewing/library": "4.10.2"
        }
      },
      "@freesewing/models@4.10.2": {
        "dependencies": {
          "@freesewing/config": "4.10.2"
        }
      },
      "@freesewing/plugin-annotations@4.10.2": {
        "dependencies": {
          "@freesewing/config": "4.10.2"
        }
      },
      "@freesewing/sasha@4.10.2": {
        "dependencies": {
          "@freesewing/library": "4.10.2",
          "@freesewing/noble": "4.10.2"
        }
      },
      "@freesewing/simon@4.10.2": {
        "dependencies": {
          "@freesewing/library": "4.10.2"
        }
      },
      "@freesewing/teagan@4.10.2": {
        "dependencies": {
          "@freesewing/library": "4.10.2"
        }
      }
    }
  }
}
